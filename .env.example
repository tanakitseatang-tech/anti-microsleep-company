# Copy to .env.local for local testing. On Vercel, set these in
# Project > Settings > Environment Variables (never commit real values).

# Postgres connection string. Vercel sets POSTGRES_URL automatically when you add
# Supabase from the Storage tab; DATABASE_URL (if set) is used first.
# Get both locally with:  npx vercel env pull .env.local
DATABASE_URL=postgres://user:password@host:6543/dbname

# Long random string used to sign login cookies (at least 32 characters).
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Random string Vercel Cron sends to /api/cron/cleanup (deletes data older than 90 days).
CRON_SECRET=change-me-too
